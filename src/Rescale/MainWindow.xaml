<ui:FluentWindow x:Class="Rescale.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Rescale.Views"
        Title="Rescale"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <ui:NavigationView x:Name="NavigationView"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="260">

            <ui:NavigationView.Header>
                <ui:TitleBar Title="Rescale"
                             ShowMaximize="True"
                             ShowMinimize="True" />
            </ui:NavigationView.Header>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Presets"
                                       TargetPageType="{x:Type views:PresetListPage}"
                                       Icon="{ui:SymbolIcon Grid24}" />
                <ui:NavigationViewItem Content="Settings"
                                       TargetPageType="{x:Type views:SettingsPage}"
                                       Icon="{ui:SymbolIcon Settings24}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Rescale 0.1.0"
                                       Icon="{ui:SymbolIcon Info24}"
                                       IsEnabled="False" />
            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>

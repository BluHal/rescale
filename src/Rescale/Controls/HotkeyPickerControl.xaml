<UserControl x:Class="Rescale.Controls.HotkeyPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="True"
             KeyDown="OnKeyDown"
             KeyUp="OnKeyUp">

    <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Width="360">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Opacity="0.18" ShadowDepth="8" />
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <ui:Button DockPanel.Dock="Right"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Appearance="Secondary"
                           Click="CloseButton_Click"
                           Width="28" Height="28" Padding="0" />
                <TextBlock Text="Record direct hotkey" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <Border x:Name="RecordingBorder"
                    Height="56" CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                    Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                    Padding="16,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Right" Text="Esc to cancel"
                               FontFamily="Cascadia Mono" FontSize="11"
                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="RecordingText" Text="Press a key combination..."
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                </DockPanel>
            </Border>

            <WrapPanel x:Name="ModifierPanel" Margin="0,12,0,0" />

            <DockPanel Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="Clear" Appearance="Secondary" Click="ClearButton_Click" Margin="0,0,6,0" />
                    <ui:Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click" IsEnabled="False" />
                </StackPanel>
                <TextBlock Text="Conflicts checked against global shortcuts."
                           FontSize="12"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>

<Page x:Class="Rescale.Views.PresetListPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           xmlns:vm="clr-namespace:Rescale.ViewModels"
>

    <Grid Margin="36,28,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Capture current"
                           Icon="{ui:SymbolIcon Camera24}"
                           Command="{Binding PresetListVm.CaptureNewPresetCommand}"
                           Margin="0,0,8,0" />
                <ui:Button Content="New preset"
                           Icon="{ui:SymbolIcon Add24}"
                           Appearance="Primary"
                           Command="{Binding PresetListVm.CreateEmptyPresetCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Presets" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Tray click rotates favorites in order. Drag to reorder."
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Tray Cycle section -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right"
                           Text="Left-click tray icon → next in order"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                           FontSize="12" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tray cycle" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ui:Badge Margin="8,0,0,0" Appearance="Info">
                        <TextBlock FontSize="11">
                            <Run Text="{Binding PresetListVm.Favorites.Count, Mode=OneWay}" />
                            <Run Text=" favorites" />
                        </TextBlock>
                    </ui:Badge>
                </StackPanel>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding PresetListVm.Favorites}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardAction Margin="0,0,10,10"
                                       Command="{Binding DataContext.PresetListVm.OpenPresetCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}">
                            <Grid MinHeight="120">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="10"
                                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
                                        <ui:SymbolIcon Symbol="Desktop24"
                                                       FontSize="20"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock FontSize="12"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{Binding Monitors.Count, Mode=OneWay}" />
                                        <Run Text=" displays" />
                                    </TextBlock>
                                </StackPanel>

                                <DockPanel Grid.Row="2" Margin="0,10,0,0">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Hotkey}"
                                               FontFamily="Cascadia Mono"
                                               FontSize="11"
                                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Hotkey, TargetNullValue='—'}"
                                               FontFamily="Cascadia Mono"
                                               FontSize="11"
                                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="Collapsed" />
                                </DockPanel>
                            </Grid>
                        </ui:CardAction>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Library section -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                           FontSize="12" VerticalAlignment="Center">
                    <Run Text="{Binding PresetListVm.Library.Count, Mode=OneWay}" />
                    <Run Text=" more presets · not in cycle" />
                </TextBlock>
                <TextBlock Text="Library" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <ui:Card Padding="0">
                <ItemsControl ItemsSource="{Binding PresetListVm.Library}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardAction Padding="14,10"
                                           Command="{Binding DataContext.PresetListVm.OpenPresetCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}">
                                <DockPanel>
                                    <ui:SymbolIcon DockPanel.Dock="Right" Symbol="ChevronRight24"
                                                   Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8"
                                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                                            Margin="0,0,14,0">
                                        <ui:SymbolIcon Symbol="Desktop24" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Monitors.Count, Mode=OneWay}" />
                                            <Run Text=" displays" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </ui:CardAction>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:Card>
        </StackPanel>

        <!-- Empty state -->
        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding PresetListVm.Favorites.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <ui:SymbolIcon Symbol="Desktop24" FontSize="48"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />
            <TextBlock Text="No presets yet" Style="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Capture your current display layout as the first preset."
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,18" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:Button Content="Capture current layout"
                           Icon="{ui:SymbolIcon Camera24}"
                           Appearance="Primary"
                           Command="{Binding PresetListVm.CaptureNewPresetCommand}"
                           Margin="0,0,8,0" />
                <ui:Button Content="Empty preset"
                           Icon="{ui:SymbolIcon Add24}"
                           Command="{Binding PresetListVm.CreateEmptyPresetCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
